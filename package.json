{
  "name": "dsh-history-fold",
  "version": "0.1.0",
  "description": "Fold the oldest part of a DSH session's surface history into one message that points at a lossless local archive, so a long session stops paying for its whole history on every request.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "history-fold",
    "lossless-archive",
    "context-compaction",
    "non-summary",
    "recoverable",
    "extractive-index",
    "token-budget"
  ],
  "license": "MIT",
  "author": "三文鱼",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mili1360/dsh-history-fold.git"
  },
  "homepage": "https://github.com/mili1360/dsh-history-fold#readme",
  "bugs": {
    "url": "https://github.com/mili1360/dsh-history-fold/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/fold-tests.mjs && node test/profile-tests.mjs && node test/edge-tests.mjs",
    "test:fold": "node test/fold-tests.mjs",
    "test:profile": "node test/profile-tests.mjs",
    "test:edge": "node test/edge-tests.mjs",
    "test:mutate": "node test/mutations.cjs",
    "test:all": "npm test && npm run test:mutate"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
