# Runtime and generated state -- never commit any of this.
node_modules/
*.log

# Plugin runtime output, written under $DSH_HOME, not here. Listed so that a
# stray copy made while debugging cannot be committed by accident.
history-fold/
logs/

# Test scratch
test/tmp/
*.tmp

# Release artefacts. `npm pack` writes the tarball here and the GitHub Release is
# what distributes it; a committed copy would double the repository size for no
# reason and go stale the moment the version changes.
*.tgz

# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/
